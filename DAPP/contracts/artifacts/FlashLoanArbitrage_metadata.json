					"details": "所有参数由链下机器人计算和提供，确保最佳执行。",
					"params": {
						"_buyRouter": "用于执行第一笔交易（买入）的DEX路由器地址",
						"_loanAmount": "借贷数量",
						"_loanToken": "借贷的代币地址 (例如 WETH)",
						"_minAmountOutFirstTrade": "执行第一笔交易后，预期的最小otherToken数量（防滑点）",
